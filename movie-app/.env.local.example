# ============================================================
# TMDB API KEY — The Movie Database
# 
# CARA DAPAT API KEY GRATIS:
# 1. Daftar di https://www.themoviedb.org/signup
# 2. Masuk ke Settings > API
# 3. Request API Key (pilih "Developer")
# 4. Isi form singkat, API key langsung dikasih
# 5. Copy API key (v3 auth) dan paste di bawah ini
# ============================================================

NEXT_PUBLIC_TMDB_KEY=ISI_API_KEY_KAMU_DISINI
